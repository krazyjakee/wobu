{
  "name": "wobu",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run",
    "check:dead-code": "knip --no-progress",
    "check:duplicates": "node scripts/check-duplication.mjs",
    "check:duplicates:report": "jscpd src src-tauri",
    "licences": "node scripts/generate-third-party-notices.mjs",
    "licences:check": "node scripts/generate-third-party-notices.mjs --check",
    "licences:tool:test": "node --test scripts/generate-third-party-notices.test.mjs",
    "check:code-health": "npm run check:dead-code && npm run check:duplicates",
    "release:check": "node scripts/release-version.mjs --check",
    "release:set": "node scripts/release-version.mjs --set",
    "release:tool:test": "node --test scripts/release-version.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jscpd": "5.0.14",
    "jsdom": "^29.1.1",
    "knip": "6.31.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
