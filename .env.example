# Anthropic API key for Enhance (text). A single secret, sent as `x-api-key`,
# from the Claude Console. See docs/08-providers.md.
#
# Dev-time only, like everything below. The shipped app reads credentials from
# the OS keychain and never from a file inside a project folder, because project
# folders get shared — and a key in one is a key handed to everyone on the share.
ANTHROPIC_API_KEY=

# Tencent Cloud credentials for Hunyuan3D (concept 3D).
#
# These are a SecretId/SecretKey PAIR, not a bearer token — requests must be
# signed with TC3-HMAC-SHA256. See docs/08-providers.md.
#
# ⚠️ A root SecretKey is an ACCOUNT-WIDE credential. Prefer a CAM sub-account
# key scoped to the 3D service.
#
# Dev-time only. The shipped app reads credentials from the OS keychain and
# never from a file inside a project folder, because project folders get shared.
TencentSecretId=
TencentSecretKey=
