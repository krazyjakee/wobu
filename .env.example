# Development-time credentials. Copy to `.env` at the repo root — that one path
# and no other.
#
# Resolution is keychain → environment → unconfigured, so anything set here is
# only consulted when the OS keychain has no `wobu/<provider>` entry. The reader
# is compiled out of release builds entirely: the shipped app reads credentials
# from the keychain and never from a file, because the file a user would reach
# for is one inside their project folder — and project folders get put on
# shares, where a key is a key handed to everyone with the path.
#
# The naming convention is the provider id upper-cased with `_API_KEY` on the
# end, so a provider added later needs no code change to be readable here. The
# Tencent pair below predates Wobu and keeps the names Tencent issued.

# Anthropic API key for Enhance (text). A single secret, sent as `x-api-key`,
# from the Claude Console. See docs/08-providers.md.
ANTHROPIC_API_KEY=

# Google Gemini API key for Enhance (text). A single secret, from AI Studio.
GEMINI_API_KEY=

# Tencent Cloud credentials for Hunyuan3D (concept 3D).
#
# These are a SecretId/SecretKey PAIR, not a bearer token — requests must be
# signed with TC3-HMAC-SHA256. See docs/08-providers.md.
#
# ⚠️ A root SecretKey is an ACCOUNT-WIDE credential. Prefer a CAM sub-account
# key scoped to the 3D service.
#
# Stored as two keychain entries — `wobu/tencent-secret-id` and
# `wobu/tencent-secret-key` — rather than one joined string. A pair squeezed
# into a single secret needs a separator that both the store and the signer
# agree on, and a mis-split there is an auth failure with no explanation.
TencentSecretId=
TencentSecretKey=
